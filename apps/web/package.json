{
  "name": "lucid-dreams-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 5170",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 5170",
    "demo": "next build && BRIDGE_MODE=runner next start -H 0.0.0.0 -p 5170",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:plan && npm run test:feedback && npm run test:live && npm run test:intents",
    "test:plan": "node --conditions=react-server --import tsx --test tests/plan.test.ts",
    "test:feedback": "node --conditions=react-server --import tsx --test tests/feedback.test.ts tests/feedback-nokey.test.ts",
    "test:live": "node --conditions=react-server --import tsx --test tests/live.test.ts tests/live-state.test.ts",
    "test:intents": "node --conditions=react-server --import tsx scripts/check-intents.ts"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@sparkjsdev/spark": "2.4.0",
    "busboy": "1.6.0",
    "katex": "0.16.22",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

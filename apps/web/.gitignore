# uploads and job state written by the bridge
.data/
next-env.d.ts
*.tsbuildinfo

# The root .gitignore drops every folder named dreams/ (meant for <repo>/dreams, the fetched bundles).
# These two are the bridge's routes, not bundles: keep them.
!/app/dreams/
!/app/api/dreams/

# the cloud build's slim copy of the bundles (~/LucidDreams-held/cloud-web.sh) and its Vercel link
/cloud-dreams/
/.vercel/
.vercel
.env*

+def _fixed_pose(sv, trainer, params):
+    """Court Side: another real view with a pose.json beside its video takes its camera from the court calibration
+    (pipeline/court/court_extra_pose.py) instead of a solve. None, and solve as before, without the file."""
+    if not (sv.video.parent / "pose.json").exists():
+        return None
+    court = str(Path(__file__).resolve().parents[1] / "court")
+    if court not in sys.path:
+        sys.path.append(court)
+    try:
+        from court_extra_pose import fixed_solve
+    except ImportError as e:
+        print(f"[source] {sv.video.stem}: pose.json, but no court_extra_pose ({e}): solving as before", flush=True)
+        return None
+    return fixed_solve(sv, trainer, params)
